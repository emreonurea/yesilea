# Claude API anahtarı. Boş bırakılırsa sunucu örnek tariflerle (deneme modu) çalışır.
ANTHROPIC_API_KEY=
# LLM_MOCK=1
PORT=8787
DB_PATH=./data/app.db
MODEL_FAST=claude-haiku-5-5
MODEL_QUALITY=claude-sonnet-5-5
# Apple ile giriş için uygulamanın bundle id'si (ör. com.sirketiniz.menu)
APPLE_BUNDLE_ID=
# Google ile giriş için OAuth istemci kimlikleri, virgülle ayrılmış (iOS, Android, Web)
GOOGLE_CLIENT_IDS=
# Kapalı test: 1 ise giriş kodu uygulamada görünür ve Premium denenebilir. Mağaza yayınından önce 0 yapın.
TEST_MODE=0
# Giriş kodunu e-postayla göndermek için Brevo API anahtarı ve doğrulanmış gönderici adresi
BREVO_API_KEY=
MAIL_FROM=
# RevenueCat abonelik bildirimi için gizli anahtar (RevenueCat → Integrations → Webhooks → Authorization header: Bearer <bu değer>)
REVENUECAT_WEBHOOK_SECRET=
# Ücretsiz sürüm sınırları
FREE_PLANS_PER_WEEK=2
FREE_TONIGHT_PER_DAY=5
FREE_SWAPS_PER_WEEK=10
