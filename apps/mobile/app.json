{
  "expo": {
    "name": "Yeşilea",
    "slug": "ne-pisirsem",
    "scheme": "nepisirsem",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.ornek.nepisirsem",
      "usesAppleSignIn": true,
      "supportsTablet": false
    },
    "android": {
      "package": "com.ornek.nepisirsem",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#16A34A"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-apple-authentication",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": false,
      "baseUrl": "/yesilea"
    },
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#15803D"
    },
    "primaryColor": "#15803D",
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/icon.png",
      "name": "Yeşilea",
      "shortName": "Yeşilea",
      "themeColor": "#15803D",
      "backgroundColor": "#F6FBF7",
      "lang": "tr"
    }
  }
}